# PracticalOS Backend Environment Configuration

# Server Port (default 3000 for hub/gateway)
PORT=3000
NODE_ENV=production

# Hub URL for client redirect links
HUB_URL=http://localhost:3000

# Allowed CORS Origins (comma separated or * for all)
CORS_ORIGIN=*

# Practical 4 — PostgreSQL Database Connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# Express Session Secret
SESSION_SECRET=practicalos_super_secret_session_key_2026
