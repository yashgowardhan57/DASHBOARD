<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Daily Pulse responsive news portal">
  <title><%= title || "Daily Pulse" %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Playfair+Display:wght@700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="top-strip">
    <div class="container top-strip-inner">
      <span>THURSDAY, OCTOBER 8, 2026</span>
      <span class="top-note">Independent • Fast • Digital</span>
    </div>
  </div>

  <header class="site-header">
    <div class="container header-main">
      <button class="menu-toggle" id="menuToggle" aria-label="Open menu" aria-expanded="false">☰</button>
      <a href="/" class="brand">
        <span class="brand-mark">DP</span>
        <span>
          <strong>DAILY PULSE</strong>
          <small>Your world. Your story.</small>
        </span>
      </a>

      <form class="search-form" action="/search" method="GET" role="search">
        <input type="search" name="q" placeholder="Search news..." aria-label="Search news" value="<%= typeof query !== 'undefined' ? query : '' %>">
        <button type="submit" aria-label="Search">⌕</button>
      </form>
    </div>

    <nav class="main-nav" id="mainNav">
      <div class="container nav-inner">
        <a href="/" class="<%= activeCategory === 'All' ? 'active' : '' %>">Home</a>
        <% categories.filter(c => c !== "All").forEach(category => { %>
          <a href="/category/<%= category.toLowerCase() %>" class="<%= activeCategory === category ? 'active' : '' %>"><%= category %></a>
        <% }) %>
      </div>
    </nav>
  </header>
