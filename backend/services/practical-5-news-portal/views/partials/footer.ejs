          <% }) %>
        </div>
      </div>
      <div>
        <h3>Project</h3>
        <p>Built with Node.js, Express, EJS, CSS Grid, Flexbox and media queries.</p>
      </div>
    </div>
    <div class="container copyright">© 2026 Daily Pulse • Demo project</div>
  </footer>
