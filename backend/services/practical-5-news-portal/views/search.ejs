<%- include('partials/header') %>

<main class="main-body">
  <div class="container">
    
    <!-- Search Query Banner -->
    <div class="category-header">
      <div class="category-breadcrumb">
        <a href="/">Front Page</a> &gt; <span>Archive Search</span>
      </div>
      <h1 class="category-page-title">Search Results</h1>
      <p class="category-page-desc">
        Query: <em>"<%= query %>"</em> &bull; Found <%= results.length %> <%= results.length === 1 ? 'matching record' : 'matching records' %>
      </p>
    </div>

    <!-- Search Results Grid -->
    <% if (results.length > 0) { %>
      <div class="news-cards-grid" style="margin-top: 2rem;">
        <% results.forEach(function(article) { %>
          <%- include('partials/news-card', { article: article }) %>
        <% }); %>
      </div>
    <% } else { %>
      <div class="empty-state-card">
        <h3>No Matching Dispatches</h3>
        <p>No published articles matched the search query "<strong><%= query %></strong>".</p>
        <p style="font-size: 0.875rem; color: #666; margin-top: 0.5rem;">
          Try keywords such as <em>Technology</em>, <em>Browsers</em>, <em>Education</em>, <em>Sports</em>, or <em>Business</em>.
        </p>
        <a href="/" class="btn-read-lead" style="margin-top: 1.5rem;">&larr; Return to Front Page</a>
      </div>
    <% } %>

  </div>
</main>

<%- include('partials/footer') %>
