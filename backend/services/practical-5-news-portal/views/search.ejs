<%- include("partials/header", { title: "Search — Daily Pulse" }) %>
<main>
  <section class="container page-heading search-heading">
    <span class="eyebrow">SEARCH</span>
    <h1><%= query ? 'Results for "' + query + '"' : "All Stories" %></h1>
    <p><%= news.length %> matching stories found.</p>
  </section>

  <section class="container content-layout">
    <div class="news-section">
      <% if (news.length) { %>
        <div class="news-grid">
          <% news.forEach(item => { %>
            <article class="news-card">
              <a href="/article/<%= item.id %>" class="card-image">
                <img src="<%= item.image %>" alt="<%= item.title %>" loading="lazy">
              </a>
              <div class="card-body">
                <span class="mini-category"><%= item.category %></span>
                <h3><a href="/article/<%= item.id %>"><%= item.title %></a></h3>
                <p><%= item.summary %></p>
                <div class="card-meta"><span><%= item.author %></span><span><%= item.date %></span></div>
              </div>
            </article>
          <% }) %>
        </div>
      <% } else { %>
        <div class="empty-state">
          <h2>No results found</h2>
          <p>Try a different keyword such as technology, sports or business.</p>
          <a class="button" href="/">Back to Home</a>
        </div>
      <% } %>
    </div>

    <aside class="sidebar">
      <div class="sidebar-box">
        <div class="section-title small"><h2>Browse</h2></div>
        <div class="category-list">
          <% categories.filter(c => c !== "All").forEach(category => { %>
            <a href="/category/<%= category.toLowerCase() %>"><%= category %><span>→</span></a>
          <% }) %>
        </div>
      </div>
    </aside>
  </section>
</main>
<%- include("partials/footer") %>
