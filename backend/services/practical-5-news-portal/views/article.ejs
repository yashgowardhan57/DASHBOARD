<%- include("partials/header", { title: article.title + " — Daily Pulse" }) %>
<main>
  <article class="container article-page">
    <div class="article-header">
      <a class="back-link" href="/category/<%= article.category.toLowerCase() %>">← <%= article.category %></a>
      <span class="eyebrow"><%= article.category %></span>
      <h1><%= article.title %></h1>
      <p class="article-summary"><%= article.summary %></p>
      <div class="article-meta">
        <span>By <strong><%= article.author %></strong></span>
        <span><%= article.date %> • <%= article.time %></span>
      </div>
    </div>

    <img class="article-image" src="<%= article.image %>" alt="<%= article.title %>">

    <div class="article-layout">
      <div class="article-content">
        <% article.content.split("\n").forEach(paragraph => { %>
          <p><%= paragraph %></p>
        <% }) %>
        <p>Daily Pulse presents this story as part of its demonstration news feed. The local data in this project can be replaced with your own headlines, descriptions, images and categories without adding a database.</p>
      </div>

      <aside class="sidebar">
        <div class="sidebar-box">
          <div class="section-title small"><h2>Related</h2></div>
          <% related.forEach(item => { %>
            <a class="related-item" href="/article/<%= item.id %>">
              <img src="<%= item.image %>" alt="">
              <span><%= item.title %></span>
            </a>
          <% }) %>
        </div>
      </aside>
    </div>
  </article>
</main>
<%- include("partials/footer") %>
