# Environment Variables Template for Render / Local
# Copy this to .env and fill in your values.
# On Render, set these in the "Environment" tab — do NOT commit .env

# ── Option 1: Cloud Database (Neon / Supabase / Railway)
# Paste the full connection string from your Neon dashboard.
# This overrides all DB_* variables below.
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require

# ── Option 2: Local PostgreSQL (fallback if DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=admin123

# ── Server
PORT=3001
NODE_ENV=production
