# Environment Variables Template for Render / Local
# Copy this to .env and fill in your values.
# On Render / Vercel, set these in the "Environment Variables" tab — do NOT commit .env

# ── Option 1: Supabase / Neon Cloud Database (Recommended)
# For Supabase, use the connection pooler URL (IPv4 + IPv6 compatible):
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-1-[region].pooler.supabase.com:5432/postgres
# Direct connection (IPv6 only):
# DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
DATABASE_URL=

# ── Option 2: Local / Custom PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=admin123
DB_SSL=false

# ── Server
PORT=3001
NODE_ENV=production
