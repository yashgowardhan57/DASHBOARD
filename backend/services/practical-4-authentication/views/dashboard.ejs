<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>User Session Dashboard — Practical 4</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/auth.css" />
</head>
<body class="auth-body">
  <a href="<%= hubUrl %>/index.html" class="back-link" id="backToHub">
    <svg width="16" height="16" viewBox="0 0 20 20" fill="currentColor">
      <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd"/>
    </svg>
    Back to Hub
  </a>

  <div class="ambient-glow glow-top"></div>

  <main class="auth-container">
    <div class="auth-brand">
      <div class="brand-badge badge-success">
        <span class="badge-dot dot-green"></span>
        Authenticated Session Active
      </div>
      <h1 class="brand-title">Welcome, <span><%= user.name %></span></h1>
      <p class="brand-subtitle">Protected Route Verified via PostgreSQL Session</p>
    </div>

    <div class="auth-card profile-card">
      <div class="profile-header">
        <div class="profile-avatar-large">
          <%= user.name.split(' ').map(function(n){ return n[0]; }).join('').substring(0, 2).toUpperCase() %>
        </div>
        <div class="profile-details">
          <h2 class="profile-user-name"><%= user.name %></h2>
          <p class="profile-user-email"><%= user.email %></p>
          <span class="role-pill">Verified Account</span>
        </div>
      </div>

      <div class="session-info-grid">
        <div class="session-stat">
          <span class="stat-label">User ID (Database Primary Key)</span>
          <span class="stat-value font-mono">#<%= user.id %></span>
        </div>
        <div class="session-stat">
          <span class="stat-label">Authentication Method</span>
          <span class="stat-value">Bcrypt Hashed + PG Session</span>
        </div>
        <div class="session-stat">
          <span class="stat-label">Session Security</span>
          <span class="stat-value">HttpOnly Cookie (24h TTL)</span>
        </div>
        <div class="session-stat">
          <span class="stat-label">Database Status</span>
          <span class="stat-value text-green">PostgreSQL Connected</span>
        </div>
      </div>

      <div class="card-actions-row">
        <form action="/logout" method="POST" style="margin: 0; width: 100%;">
          <button type="submit" class="btn-logout">
            <svg width="18" height="18" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M3 3a1 1 0 00-1 1v12a1 1 0 102 0V4a1 1 0 00-1-1zm10.293 9.293a1 1 0 001.414 1.414l3-3a1 1 0 000-1.414l-3-3a1 1 0 10-1.414 1.414L14.586 9H7a1 1 0 100 2h7.586l-1.293 1.293z" clip-rule="evenodd"/>
            </svg>
            Sign Out of Session
          </button>
        </form>
      </div>
    </div>
  </main>
</body>
</html>
